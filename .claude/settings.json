{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m pytest:*)",
      "Bash(python -m py_compile:*)",
      "Bash(python -c:*)",
      "Bash(streamlit run:*)",
      "Bash(pip install -r requirements.txt)",
      "Bash(pip list:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Read(//c/Users/tpoll/lady-bulldogs-monte-carlo/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.streamlit/secrets.toml)",
      "Read(//c/Users/tpoll/.claude/.credentials.json)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/check_python_syntax.py"
          }
        ]
      }
    ]
  }
}
